{
  "name": "avodado",
  "version": "0.35.5",
  "description": "Documentation-as-code CLI: write Markdown with typed YAML blocks for API docs, architecture & system design (C4, ERDs, sequence diagrams), frontend & design systems, ADRs and decision records, planning, and slide presentations. Validate like code with `avo check`, export to themed HTML, slides, or PDF. AI-native — author with Claude, Cursor, or Copilot and edit visually in Avodado Studio.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/bin.js",
  "bin": {
    "avo": "./dist/bin.js",
    "avodado": "./dist/bin.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && chmod +x dist/bin.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@avodado/core": "workspace:*",
    "@avodado/render": "workspace:*",
    "@avodado/studio": "workspace:*",
    "cfonts": "^3.3.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "ink": "^5.1.0",
    "ink-select-input": "^6.0.0",
    "ink-table": "^3.1.0",
    "jiti": "^2.4.2",
    "open": "^10.1.0",
    "picocolors": "^1.1.1",
    "react": "^18.3.1",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "ink-testing-library": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdiejim/avodado.git",
    "directory": "packages/cli"
  },
  "homepage": "https://avodado.dev",
  "bugs": "https://github.com/jdiejim/avodado/issues",
  "keywords": [
    "avodado",
    "documentation",
    "docs-as-code",
    "documentation-as-code",
    "markdown",
    "yaml",
    "typed-blocks",
    "diagrams",
    "diagrams-as-code",
    "mermaid-alternative",
    "sequence-diagram",
    "erd",
    "c4-model",
    "api-docs",
    "api-documentation",
    "system-design",
    "architecture",
    "architecture-diagrams",
    "adr",
    "design-system",
    "presentations",
    "technical-writing",
    "developer-docs",
    "ai-documentation",
    "claude",
    "cursor",
    "copilot",
    "mcp",
    "studio",
    "visual-editor",
    "html",
    "slides",
    "pdf",
    "static-site-generator",
    "cli",
    "developer-tools"
  ],
  "engines": {
    "node": ">=20"
  }
}
